# Flutter apps read configuration at build time, not from a .env file:
#
#   flutter run -d chrome \
#     --dart-define=API_BASE_URL=http://127.0.0.1:8000 \
#     --dart-define=MAPTILER_API_KEY=<your-maptiler-key> \
#     --dart-define=DEMO_MODE=false
#
# API_BASE_URL     backend origin (no trailing slash, no /api/v1)
# MAPTILER_API_KEY optional, enables location autocomplete tiles
# DEMO_MODE        true shows one-tap role logins and the demo banner
